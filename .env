# Database connection
# Default local SQLite file for zero-config startup:
DATABASE_URL="file:./dev.db"

# For PostgreSQL production, update DATABASE_URL and in prisma/schema.prisma set provider = "postgresql":
# DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_pos?schema=public"

# Authentication secret
JWT_SECRET="hotel-pos-secure-jwt-secret-key-production-2025"

# Application info
NEXT_PUBLIC_APP_NAME="HOTEL JB POS"
NEXT_PUBLIC_HOTEL_NAME="HOTEL JB"
NEXT_PUBLIC_HOTEL_ADDRESS="Main Road, City Center"
NEXT_PUBLIC_HOTEL_PHONE="+91 98765 43210"
